FROM quay.io/fedora/fedora:43

ENV UV_PYTHON_INSTALL_DIR=/usr/local/share/uv/python
ENV UV_CACHE_DIR=/usr/local/share/uv/cache

# DNF Cache Mount: Behält heruntergeladene RPMs über Builds hinweg,
# falls der Layer neu gebaut werden muss.
RUN --mount=type=cache,target=/var/cache/dnf \
    dnf -y update && dnf -y install \
    bash bash-completion shadow-utils sudo \
    git gh tmux \
    nano vim-minimal less \
    curl wget ca-certificates \
    nodejs npm \
    python3 python3-pip \
    make gcc gcc-c++ \
    ripgrep fd-find jq unzip tar gzip xz which file \
    iputils iproute procps-ng psmisc util-linux \
    findutils grep sed gawk diffutils \
    hostname bind-utils net-tools traceroute \
    lsof strace tcpdump nmap-ncat \
    v4l-utils zbar ffmpeg mpv libv4l \
    dbus-x11 xauth mesa-dri-drivers \
    tailscale \
 && dnf clean all

RUN curl -fL \
    https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-amd64 \
    -o /usr/local/bin/cloudflared \
 && chmod +x /usr/local/bin/cloudflared \
 && cloudflared --version

# NPM Cache Mount: Prüft @latest, aber lädt die Tarballs nur herunter,
# wenn sie nicht schon im globalen NPM-Cache des Host-Builders liegen.
RUN --mount=type=cache,target=/root/.npm \
    npm install -g --include=optional\
    @openai/codex@latest \
    @anthropic-ai/claude-code@latest \
    openclaw@latest

RUN curl -LsSf https://astral.sh/uv/install.sh | sh

RUN curl -fsSL https://raw.githubusercontent.com/NousResearch/hermes-agent/main/scripts/install.sh \
      | bash -s -- --skip-setup

RUN useradd -m -s /bin/bash appuser || true

RUN cat >/etc/profile.d/gui-container.sh <<'EOS'
export DISPLAY="${DISPLAY:-:0}"
export NO_AT_BRIDGE="${NO_AT_BRIDGE:-1}"
export HERMES_HOME="${HERMES_HOME:-/root/hermes-home}"
export HERMES_INSTALL_DIR="${HERMES_INSTALL_DIR:-/usr/local/lib/hermes-agent}"
export UV_PYTHON_INSTALL_DIR="${UV_PYTHON_INSTALL_DIR:-/usr/local/share/uv/python}"
export UV_CACHE_DIR="${UV_CACHE_DIR:-/usr/local/share/uv/cache}"

if [ -z "$XDG_RUNTIME_DIR" ] || [ "$XDG_RUNTIME_DIR" = "/tmp" ]; then
  export XDG_RUNTIME_DIR="/tmp/runtime-${USER:-container}"
fi

mkdir -p "$XDG_RUNTIME_DIR" 2>/dev/null || true
chmod 700 "$XDG_RUNTIME_DIR" 2>/dev/null || true
EOS

RUN cat >>/etc/bashrc <<'EOS'

[ -f /etc/profile.d/gui-container.sh ] && . /etc/profile.d/gui-container.sh
EOS

COPY safrano9999/CODEANALYST /safrano/CODEANALYST
COPY safrano9999/JUGO /safrano/JUGO

RUN --mount=type=cache,target=/root/.cache/pip \
    pip install \
    -r /safrano/CODEANALYST/requirements.txt \
    -r /safrano/JUGO/requirements.txt

EXPOSE 11000 11001

RUN cat >/start.sh <<'EOS'
#!/bin/bash
set -e
(cd /safrano/CODEANALYST && uvicorn webui:app --host 0.0.0.0 --port 11000) &
(cd /safrano/JUGO && uvicorn webui:app --host 0.0.0.0 --port 11001) &
wait
EOS
RUN chmod +x /start.sh

CMD ["/start.sh"]
