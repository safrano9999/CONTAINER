# BIP39 web UI internal port
BIP39_PORT=11002

# OpenClaw Gateway internal port
OPENCLAW_GATEWAY_PORT=18789

# OpenClaw cron times for DAILYNEWS, CALENDAR, ZEROINBOX and KACHELMANN
OPENCLAW_CRONTAB=CET 01:23,CET 07:00,CET 09:40,CET 12:00,CET 15:30,CET 19:00

# Run the generated fullrun webhook script once after OpenClaw startup
SAFRANO9999_FULLRUN_ON_START=1

# Hermes dashboard internal port
HERMES_DASHBOARD_PORT=9119

# Hermes OpenAI compatible API internal port
HERMES_API_SERVER_PORT=8642

# KACHELMANN WebUI internal port inside fedora43-ai
KACHELMANN_PORT=11006

# NaturalGrounding video storage path used by the app
NATURALGROUNDING_VIDEOS_DIR=/vol/VIDEOS

# NaturalGrounding persistent Django identity and billing database path
NATURALGROUNDING_SQLITE_PATH=/var/lib/naturalgrounding/django.sqlite3
