# BIP39 web UI internal port
BIP39_PORT=11002

# BIP39 web UI host port
BIP39_PUBLISH_PORT=11002

# OpenClaw Gateway internal port
OPENCLAW_GATEWAY_PORT=18789

# OpenClaw Gateway host port
OPENCLAW_GATEWAY_PUBLISH_PORT=20789

# OpenClaw cron times for DAILYNEWS, CALENDAR, ZEROINBOX and KACHELMANN
OPENCLAW_CRONTAB=CET 01:23,CET 07:00,CET 09:40,CET 12:00,CET 15:30,CET 19:00

# Run the generated fullrun webhook script once after OpenClaw startup
SAFRANO9999_FULLRUN_ON_START=1

# Hermes dashboard internal port
HERMES_DASHBOARD_PORT=9119

# Hermes dashboard host port
HERMES_DASHBOARD_PUBLISH_PORT=19119

# Hermes OpenAI compatible API internal port
HERMES_API_SERVER_PORT=8642

# Hermes OpenAI compatible API host port
HERMES_API_SERVER_PUBLISH_PORT=18642

# KACHELMANN WebUI internal port inside fedora43-ai
KACHELMANN_PORT=11006

# KACHELMANN WebUI host port for fedora43-ai
KACHELMANN_PUBLISH_PORT=11006

# PV_D-A-CH database host from inside the Fedora container
PV_DACH_DB_HOST=host.containers.internal

# NaturalGrounding video storage path used by the app
NATURALGROUNDING_VIDEOS_DIR=/vol/VIDEOS

# Mount-bind Volume for NaturalGrounding videos
NATURALGROUNDING_VOLUMES=/vol/VIDEOS:/vol/VIDEOS:Z

# NaturalGrounding rootless Podman group passthrough for writable shared videos
NATURALGROUNDING_GROUP_ADD=keep-groups

# NaturalGrounding persistent Django identity and billing database path
NATURALGROUNDING_SQLITE_PATH=/var/lib/naturalgrounding/django.sqlite3

# NaturalGrounding persistent Django identity and billing volume
NATURALGROUNDING_STATE_VOLUMES=naturalgrounding-state:/var/lib/naturalgrounding:Z

# Fedora43 AI local init/auth volume
FEDORA43_AI_VOLUMES=fedora43-ai:/fedora:Z

# Native Codex CLI auth/state (uncomment to persist direct Codex login)
# FEDORA43_AI_CODEX_CLI_AUTH_VOLUMES=fedora43-ai-codex-cli-auth:/root/.codex:Z

# OpenClaw model auth profiles + OpenClaw auth secret dir (openclaw models auth login)
# FEDORA43_AI_OPENCLAW_GPT_AUTH_VOLUMES=fedora43-ai-openclaw-gpt-auth-profiles:/root/.openclaw/agents:Z,fedora43-ai-openclaw-gpt-auth-secrets:/root/.config/openclaw:Z
