DISPLAY=:0
NO_AT_BRIDGE=1
XDG_RUNTIME_DIR=/tmp/runtime-root
OPENCLAW_START=1
HERMES_START=1
OPENCLAW_GATEWAY_TOKEN=example: openssl rand -hex 32
OPENCLAW_LITELLM_MODEL=deepseek-v4-flash
HERMES_LITELLM_MODEL=deepseek-v4-flash
HERMES_API_SERVER_KEY=
TELEGRAMTOKEN_OPENCLAW=
# Optional Telegram chat id for scheduled plugin output.
OPENCLAW_TELEGRAM_TARGET=
# Optional GitHub token injected at runtime for private repos and pushes.
GH_TOKEN=
TELEGRAMTOKEN_HERMES=Hermes-Agent
BRAVE_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=
PV_DACH_DB_HOST=host.containers.internal
