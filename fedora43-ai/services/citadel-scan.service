[Unit]
Description=CITADEL initial scan
After=codeanalyst.service jugo.service bip39.service pvdach.service kiwix-bridge.service napoleon.service naturalgrounding.service citadel.service openclaw.service hermes-dashboard.service hermes.service
Wants=codeanalyst.service jugo.service bip39.service pvdach.service kiwix-bridge.service napoleon.service naturalgrounding.service citadel.service openclaw.service hermes-dashboard.service hermes.service

[Service]
Type=oneshot
WorkingDirectory=/opt/safrano9999/CITADEL
PassEnvironment=CITADEL_WEBUI_PORT CITADEL_SCAN_ON_START CITADEL_SCAN_DELAY CITADEL_DATA_DIR CITADEL_SUBNET_IP CITADEL_ENABLE_TAILSCALE TS_STATE_DIR TS_AUTHKEY TS_HOSTNAME HOST CODEANALYST_PORT JUGO_PORT USE_TMUX TMUX_SHELL JUGO_TMUX_SESSION_PREFIX DB_TYPE DB_PATH DB_URL DB_PORT DB_NAME_JUGO DB_USER_JUGO DB_PW_JUGO DEEPL_API_KEY XAI_API_KEY OPENAI_API_KEY GEMINI_API_KEY ELEVENLABS_API_KEY GOOGLE_TTS_CREDENTIALS LITELLM_URL LITELLM_PORT LITELLM_API_KEY BIP39_PORT HERMES_DASHBOARD_PORT HERMES_API_SERVER_PORT OPENCLAW_GATEWAY_PORT CLAUDE_CODE_OAUTH_TOKEN
Environment=CITADEL_SCAN_DELAY=60
ExecStartPre=/bin/sleep ${CITADEL_SCAN_DELAY}
ExecStart=/bin/bash scan.sh

[Install]
WantedBy=multi-user.target
