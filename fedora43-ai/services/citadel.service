[Unit]
Description=CITADEL
After=network.target citadel-setup.service
Requires=citadel-setup.service

[Service]
Type=simple
WorkingDirectory=/opt/safrano9999/CITADEL
PassEnvironment=CITADEL_WEBUI_PORT CITADEL_SCAN_ON_START CITADEL_SCAN_DELAY CITADEL_DATA_DIR CITADEL_SUBNET_IP CITADEL_ENABLE_TAILSCALE TS_STATE_DIR TS_AUTHKEY TS_HOSTNAME HOST CODEANALYST_PORT JUGO_PORT USE_TMUX TMUX_SHELL JUGO_TMUX_SESSION_PREFIX DB_TYPE DB_PATH DB_URL DB_PORT DB_NAME_JUGO DB_USER_JUGO DB_PW_JUGO DEEPL_API_KEY XAI_API_KEY OPENAI_API_KEY GEMINI_API_KEY ELEVENLABS_API_KEY GOOGLE_TTS_CREDENTIALS LITELLM_URL LITELLM_PORT LITELLM_API_KEY BIP39_PORT CLAUDE_CODE_OAUTH_TOKEN
Environment=CITADEL_WEBUI_PORT=10999
ExecStart=uvicorn webui:app --host 0.0.0.0 --port ${CITADEL_WEBUI_PORT}
Restart=on-failure

[Install]
WantedBy=multi-user.target
