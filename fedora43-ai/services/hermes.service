[Unit]
Description=Hermes Agent gateway
After=tailscale-up.service
Wants=tailscale-up.service

[Service]
Type=simple
PassEnvironment=LITELLM_API_KEY LITELLM_URL LITELLM_PORT OPENCLAW_LITELLM_MODEL HERMES_LITELLM_MODEL HERMES_START TELEGRAMTOKEN_HERMES HERMES_API_SERVER_KEY HERMES_API_SERVER_PORT HERMES_API_SERVER_HOST API_SERVER_KEY API_SERVER_CORS_ORIGINS API_SERVER_MODEL_NAME
Environment=HOME=/root
ExecCondition=/bin/bash -c '[ "$${HERMES_START:-1}" = "1" ] && [ -n "$$LITELLM_API_KEY" ] && [ -n "$$LITELLM_URL" ] && [ -n "$$LITELLM_PORT" ]'
ExecStartPre=/usr/local/bin/hermes-patch-ssl-verify
ExecStartPre=/usr/local/bin/hermes-configure-litellm
ExecStart=/bin/bash -lc 'set -e; base="$${LITELLM_URL%/}"; base="$${base%/v1}"; export OPENAI_API_KEY="$$LITELLM_API_KEY"; export OPENAI_BASE_URL="$${base}:$${LITELLM_PORT}/v1"; if [ -n "$${HERMES_API_SERVER_KEY:-}" ]; then export API_SERVER_KEY="$$HERMES_API_SERVER_KEY"; fi; if [ -n "$${API_SERVER_KEY:-}" ]; then export API_SERVER_ENABLED=true; export API_SERVER_HOST="$${HERMES_API_SERVER_HOST:-0.0.0.0}"; export API_SERVER_PORT="$${HERMES_API_SERVER_PORT:-8642}"; fi; export GATEWAY_ALLOW_ALL_USERS=true; export TELEGRAM_ALLOW_ALL_USERS=true; export HERMES_ALLOW_ROOT_GATEWAY=1; export HERMES_ACCEPT_HOOKS=1; if [ -n "$$TELEGRAMTOKEN_HERMES" ] && [ "$$TELEGRAMTOKEN_HERMES" != "Hermes-Agent" ]; then export TELEGRAM_BOT_TOKEN="$$TELEGRAMTOKEN_HERMES"; fi; exec /usr/local/bin/hermes gateway run --replace'
Restart=on-failure
RestartSec=5
TimeoutStartSec=60
TimeoutStopSec=240

[Install]
WantedBy=multi-user.target
