[Unit]
Description=NaturalGrounding
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/safrano9999/NaturalGrounding-Tiktok-Ying-Video-Manager
PassEnvironment=FASTAPI_HOST NATURALGROUNDING_PORT NATURALGROUNDING_DB_BACKEND NATURALGROUNDING_DB_HOST NATURALGROUNDING_DB_PORT NATURALGROUNDING_DB_NAME NATURALGROUNDING_DB_USER NATURALGROUNDING_DB_PASSWORD NATURALGROUNDING_DATABASE_URL NATURALGROUNDING_VIDEOS_DIR
PassEnvironment=NATURALGROUNDING_SQLITE_PATH NATURALGROUNDING_DJANGO_SECRET_KEY NATURALGROUNDING_ADMIN_EMAIL NATURALGROUNDING_ADMIN_PASSWORD NATURALGROUNDING_PUBLIC_HOST NATURALGROUNDING_ALLOWED_HOSTS NATURALGROUNDING_CSRF_TRUSTED_ORIGINS
PassEnvironment=NATURALGROUNDING_GOOGLE_CLIENT_ID NATURALGROUNDING_GOOGLE_CLIENT_SECRET NATURALGROUNDING_GITHUB_CLIENT_ID NATURALGROUNDING_GITHUB_CLIENT_SECRET NATURALGROUNDING_APPLE_CLIENT_ID NATURALGROUNDING_APPLE_CLIENT_SECRET NATURALGROUNDING_MICROSOFT_CLIENT_ID NATURALGROUNDING_MICROSOFT_CLIENT_SECRET
PassEnvironment=NATURALGROUNDING_STRIPE_SECRET_KEY NATURALGROUNDING_STRIPE_WEBHOOK_SECRET NATURALGROUNDING_STRIPE_MONTHLY_PRICE_ID NATURALGROUNDING_STRIPE_YEARLY_PRICE_ID
Environment=NATURALGROUNDING_PORT=11005
ExecStart=/opt/safrano9999/NaturalGrounding-Tiktok-Ying-Video-Manager/start.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
