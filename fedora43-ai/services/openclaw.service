[Unit]
Description=OpenClaw AI gateway
After=tailscale-up.service
Wants=tailscale-up.service

[Service]
Type=simple
PassEnvironment=LITELLM_API_KEY LITELLM_URL LITELLM_PORT TS_AUTHKEY TS_HOSTNAME OPENCLAW_LITELLM_MODEL OPENCLAW_LITELLM_MODEL_NAME OPENCLAW_LITELLM_CONTEXT_WINDOW OPENCLAW_LITELLM_MAX_TOKENS OPENCLAW_START OPENCLAW_GATEWAY_TOKEN TELEGRAMTOKEN_OPENCLAW BRAVE_API_KEY VIKUNJA_HOST VIKUNJA_URL TOKEN_WORKER TOKEN_ARCHITECT TOKEN_QC
ExecCondition=/bin/bash -c '[ "$${OPENCLAW_START:-1}" = "1" ] && [ -n "$$LITELLM_API_KEY" ] && [ -n "$$LITELLM_URL" ] && [ -n "$$LITELLM_PORT" ]'
ExecStartPre=/bin/bash -c 'openclaw onboard --non-interactive --accept-risk --skip-health --auth-choice litellm-api-key --litellm-api-key "$$LITELLM_API_KEY" --custom-base-url "$${LITELLM_URL}:$${LITELLM_PORT}/v1"'
ExecStartPre=/usr/local/bin/openclaw-configure-litellm
ExecStart=/bin/bash -lc 'args=(gateway run --bind lan --port 18789); if [ -n "$${OPENCLAW_GATEWAY_TOKEN:-}" ]; then args+=(--auth token --token "$$OPENCLAW_GATEWAY_TOKEN"); fi; exec /usr/local/bin/openclaw "$${args[@]}"'
Restart=on-failure
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target
