[Unit]
Description=PV_D-A-CH
After=network.target tailscale-up.service
Wants=tailscale-up.service

[Service]
Type=simple
WorkingDirectory=/opt/safrano9999/PV_D-A-CH
PassEnvironment=HOST PV_DACH_PORT PV_DACH_DB_BACKEND PV_DACH_DB_HOST PV_DACH_DB_PORT PV_DACH_DB_USER PV_DACH_DB_PASSWORD PV_DACH_DB_NAME PV_DACH_DATABASE_URL LITELLM_URL LITELLM_PORT LITELLM_API_KEY PV_DACH_LITELLM_MODEL
Environment=PV_DACH_PORT=11003
ExecStart=uvicorn webui:app --host 0.0.0.0 --port ${PV_DACH_PORT}
Restart=on-failure

[Install]
WantedBy=multi-user.target
