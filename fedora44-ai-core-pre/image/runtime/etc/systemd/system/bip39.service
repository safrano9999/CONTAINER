[Unit]
Description=BIP39 static web application
After=network.target
ConditionPathExists=/usr/local/share/bip39/index.html

[Service]
Type=simple
WorkingDirectory=/usr/local/share/bip39
ExecCondition=/bin/bash -lc '[ -n "$${BIP39_PORT:-}" ]'
ExecStart=/bin/bash -lc 'exec python3 -m http.server "${BIP39_PORT}" --bind 0.0.0.0'
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
