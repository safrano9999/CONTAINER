ARG AI_CORE_PRE_IMAGE=ghcr.io/safrano9999/fedora44-ai-core-pre:latest
FROM ${AI_CORE_PRE_IMAGE} AS ai-core

ARG OPENCLAW_VERSION=2026.7.1
ARG NOTE_REPOSITORY
ARG NOTE_RELEASE_TAG
ARG NOTE_RELEASE_ASSET
ARG NOTE_RELEASE_SHA256

LABEL org.opencontainers.image.title="fedora44-ai-core" \
      org.opencontainers.image.description="Small ephemeral OpenClaw, NOTE, Hermes configuration, and systemd runtime layer on fedora44-ai-core-pre." \
      org.opencontainers.image.source="https://github.com/safrano9999/CONTAINER" \
      io.safrano9999.parent="fedora44-ai-core-pre" \
      io.safrano9999.openclaw.version="${OPENCLAW_VERSION}" \
      io.safrano9999.note.repository="${NOTE_REPOSITORY}" \
      io.safrano9999.note.release="${NOTE_RELEASE_TAG}"

# Assemble the verified, distro-neutral OpenClaw payload directly on Fedora.
# No container image other than the generic Core-pre parent is used as a source.
ENV HOME=/root \
    OPENCLAW_CONFIG_DIR=/root/.openclaw \
    OPENCLAW_CONFIG=/root/.openclaw/openclaw.json \
    OPENCLAW_GATEWAY_PORT=18789 \
    OPENCLAW_DISABLE_BONJOUR=1 \
    PYTHONPATH=/usr/local/lib/openclaw-ephemeral \
    PYTHONUNBUFFERED=1

RUN install -d -o root -g root -m 0700 "${OPENCLAW_CONFIG_DIR}"

COPY build/vendor/openclaw-deterministic/openclaw-deterministic.tar.gz /tmp/openclaw-deterministic.tar.gz

RUN set -euo pipefail; \
    openclaw_root="$(npm root -g)/openclaw"; \
    test "$(jq -r .version "$openclaw_root/package.json")" = "${OPENCLAW_VERSION}"; \
    cp -a "$openclaw_root/dist/control-ui" /tmp/openclaw-control-ui; \
    rm -rf "$openclaw_root/dist"; \
    tar -xzf /tmp/openclaw-deterministic.tar.gz -C "$openclaw_root"; \
    mv /tmp/openclaw-control-ui "$openclaw_root/dist/control-ui"; \
    rm -f /tmp/openclaw-deterministic.tar.gz; \
    test -s "$openclaw_root/dist/control-ui/index.html"; \
    test -f "$openclaw_root/dist/extensions/codex/index.js"; \
    rm -rf /root/.openclaw/extensions/codex; \
    test ! -e /root/.openclaw/extensions/codex; \
    node "$openclaw_root/openclaw.mjs" --version | grep -F "${OPENCLAW_VERSION}"

COPY build/vendor/openclaw-ephemeral/openclaw_ephemeral/ /usr/local/lib/openclaw-ephemeral/openclaw_ephemeral/
COPY build/vendor/openclaw-ephemeral/openclaw-ephemeral.py /usr/local/bin/openclaw-ephemeral.py
COPY build/vendor/openclaw-ephemeral/runtime/yolo.sh /usr/local/bin/openclaw-ephemeral-yolo

RUN chmod 0755 /usr/local/bin/openclaw-ephemeral.py \
      /usr/local/bin/openclaw-ephemeral-yolo \
 && chown -R root:root /usr/local/lib/openclaw-ephemeral \
      /usr/local/bin/openclaw-ephemeral.py \
      /usr/local/bin/openclaw-ephemeral-yolo

COPY build/vendor/note/note-latest.zip /tmp/note-latest.zip

RUN set -euo pipefail; \
    openclaw_root="$(npm root -g)/openclaw"; \
    printf '%s  %s\n' "${NOTE_RELEASE_SHA256}" /tmp/note-latest.zip | sha256sum -c -; \
    openclaw plugins install \
      --force \
      --dangerously-force-unsafe-install \
      /tmp/note-latest.zip; \
    rm -f /tmp/note-latest.zip; \
    test -f /root/.openclaw/extensions/note/openclaw.plugin.json; \
    note_python="$(/root/.openclaw/extensions/note/scripts/setup-python.sh)"; \
    "$note_python" -c 'import dotenv, sqlalchemy, psycopg, pymysql'; \
    rm -rf /root/.openclaw/extensions/note/.uv; \
    node "$openclaw_root/openclaw.mjs" --version | grep -F "${OPENCLAW_VERSION}"; \
    find /root/.openclaw -maxdepth 1 -name 'openclaw.json*' -delete

COPY build/services/vditor-notes/ /usr/local/lib/vditor-notes/

# Runtime order is owned here: named-volume projection, Tailscale, Cockpit,
# Vditor, fresh OpenClaw configuration/gateway, then Hermes.
COPY image/runtime.d/fedora44-ai-init.sh /usr/local/bin/fedora44-ai-init
COPY image/runtime.d/fedora44-runtime-environment-generator.sh /usr/lib/systemd/system-generators/fedora44-runtime-environment-generator
COPY image/runtime.d/hermes-ephemeral.py /usr/local/bin/hermes-ephemeral.py
COPY image/runtime.d/named_volume_links.sh image/runtime.d/named_volume_links_openclaw.sh \
     image/runtime.d/named_volume_links_hermes.sh optional_persistence.sh \
     image/runtime.d/tailscale-state-up.sh /usr/local/bin/
COPY image/systemd/ /etc/systemd/system/

RUN chmod 0755 \
      /usr/local/bin/fedora44-ai-init \
      /usr/local/bin/hermes-ephemeral.py \
      /usr/local/bin/named_volume_links.sh \
      /usr/local/bin/named_volume_links_openclaw.sh \
      /usr/local/bin/named_volume_links_hermes.sh \
      /usr/local/bin/optional_persistence.sh \
      /usr/local/bin/tailscale-state-up.sh \
      /usr/lib/systemd/system-generators/fedora44-runtime-environment-generator \
 && mkdir -p /usr/local/share/fedora44-ai/init.d \
 && systemctl enable \
      fedora44-ai.service \
      tailscaled.service \
      tailscale-up.service \
      cockpit.service \
      vditor-notes.service \
      openclaw-config.service \
      openclaw.service \
      hermes.service \
      hermes-dashboard.service \
 && systemctl mask cockpit.socket \
 && sed -i '1i auth       sufficient   pam_permit.so' /etc/pam.d/cockpit

USER root
WORKDIR /root
STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
