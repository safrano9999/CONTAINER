# config.sh: autodetect GUI env, headless, or enter values manually
DISPLAY=:0
NO_AT_BRIDGE=1
XDG_RUNTIME_DIR=/tmp/runtime-root

#default-preset: insert later
#secret
TS_AUTHKEY=

#required:
OPENCLAW_START=1
#required:
HERMES_START=1
#required:
#secret
OPENCLAW_GATEWAY_TOKEN=example: openssl rand -hex 32
#repeat-group: OPENAI_V1 suffix OPENAI_V1_PROVIDER OPENAI_V1_URL OPENAI_V1_PORT OPENAI_V1_KEY OPENAI_V1_API_KEY_ALIAS OPENAI_V1_STREAM
#required:
OPENAI_V1_PROVIDER=litellm
#required:
OPENAI_V1_URL=http://169.254.1.2
#default-preset: 4000
#required:
OPENAI_V1_PORT=4000
#required:
#secret
OPENAI_V1_KEY=
#reverse-varname: OPENAI_V1_KEY
#required:
OPENAI_V1_API_KEY_ALIAS=
#default-preset: true
OPENAI_V1_STREAM=true
#default-preset: luna
#required:
OPENCLAW_OPENAI_V1_DEFAULT_LLM=luna
#default-preset: luna
#required:
HERMES_MODEL=luna
#valuedupe: HERMES_DASHBOARD_BASIC_AUTH_PASSWORD
#required:
#secret
HERMES_API_SERVER_KEY=example: openssl rand -hex 32
#default-preset: hermes
#required:
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=hermes
#required:
#secret
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=example: openssl rand -hex 32
#required:
#secret
OPENCLAW_TELEGRAMTOKEN=
#secret
GH_TOKEN=
#required:
#secret
HERMES_TELEGRAMTOKEN=Hermes-Agent
#secret
BRAVE_API_KEY=
#secret
CLAUDE_CODE_OAUTH_TOKEN=

#repeat-group: MCP_SERVER suffix02 MCP_SERVER_NAME MCP_SERVER_URL MCP_SERVER_BEARER
#repeat-optional-complete: MCP_SERVER_NAME MCP_SERVER_BEARER
MCP_SERVER_NAME=
MCP_SERVER_URL=
#secret
MCP_SERVER_BEARER=

#choices: file sqlite mariadb postgres
#default-preset: file
#named-volume: /named_volumes/NOTE_SQLITE /named_volumes/NOTE_SQLITE /root/.openclaw/extensions/note/sqlite dir
NOTE_DB_BACKEND=file

#blank-if: NOTE_DB_BACKEND=file NOTE_DB_URL NOTE_DB_PORT NOTE_DB_NAME NOTE_DB_USER NOTE_DB_PW NOTE_DB_PREFIX
#blank-if: NOTE_DB_BACKEND=sqlite NOTE_DB_URL NOTE_DB_PORT NOTE_DB_NAME NOTE_DB_USER NOTE_DB_PW NOTE_DB_PREFIX
NOTE_DB_URL=127.0.0.1

NOTE_DB_PORT=5432

NOTE_DB_NAME=note

NOTE_DB_USER=note

#secret
NOTE_DB_PW=

NOTE_DB_PREFIX=note

#default-preset: insert later
#secret
TUNNEL_TOKEN=
