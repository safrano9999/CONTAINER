[Unit]
Description=Integrate final OpenClaw repository schedules
Requires=openclaw.service
After=openclaw.service

[Service]
Type=oneshot
Environment=HOME=/root
ExecCondition=/bin/bash -c '[ "$${OPENCLAW_START:-1}" = "1" ]'
ExecStart=/usr/local/bin/openclaw-ephemeral.py schedule
RemainAfterExit=yes
TimeoutStartSec=infinity

[Install]
WantedBy=multi-user.target
