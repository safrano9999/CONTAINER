[Unit]
Description=OpenClaw gateway
Requires=fedora44-ai.service openclaw-config.service
After=fedora44-ai.service tailscale-up.service openclaw-config.service
Wants=tailscale-up.service

[Service]
Type=simple
Environment=HOME=/root
ExecCondition=/bin/bash -c '[ "$${OPENCLAW_START:-1}" = "1" ]'
ExecStart=/bin/bash -lc 'args=(gateway run --bind lan --port "$${OPENCLAW_GATEWAY_PORT:-18789}"); if [ -n "$${OPENCLAW_GATEWAY_TOKEN:-}" ]; then args+=(--auth token); fi; exec /usr/local/bin/openclaw "$${args[@]}"'
Restart=always
RestartSec=5
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target
