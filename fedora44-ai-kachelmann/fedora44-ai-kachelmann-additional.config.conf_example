BIP39_PORT=11030

#default-preset: CET 07:00,CET 13:00,CET 19:00
OPENCLAW_CRONTAB_TIME=CET 07:00,CET 13:00,CET 19:00

#default-preset: WELCOME,NEXTCLOUD,KACHELMANN
OPENCLAW_CRONTAB_REPOS=WELCOME,NEXTCLOUD,KACHELMANN

#default-preset: WELCOME,NEXTCLOUD,KACHELMANN
OPENCLAW_REPOS_START_INIT=WELCOME,NEXTCLOUD,KACHELMANN

#choices: false true
