[Unit]
Description=Install KACHELMANN OpenClaw plugin
After=openclaw-config.service openclaw-safrano9999-base.service
Requires=openclaw-config.service openclaw-safrano9999-base.service
Before=openclaw.service

[Service]
Type=oneshot
PassEnvironment=OPENCLAW_START OPENCLAW_CONFIG OPENCLAW_BIN OPENCLAW_CRONTAB OPENCLAW_TELEGRAM_CHAT_ID
ExecCondition=/bin/bash -c '[ "$${OPENCLAW_START:-1}" = "1" ]'
ExecStart=/usr/local/bin/openclaw-layer-runtime --repos KACHELMANN
RemainAfterExit=yes
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
