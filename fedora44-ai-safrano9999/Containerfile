ARG AI_BASE_IMAGE
FROM ${AI_BASE_IMAGE} AS ai-safrano9999

ARG SAFRANO9999_SOURCE_KEY

LABEL org.opencontainers.image.source="https://github.com/safrano9999/CONTAINER" \
      org.opencontainers.image.title="fedora44-ai-safrano9999" \
      org.opencontainers.image.description="Fedora 44 AI Safrano repository and service contributions." \
      io.safrano9999.parent="fedora44-ai-base" \
      io.safrano9999.source-tags.sha256="${SAFRANO9999_SOURCE_KEY}"

USER root

COPY requirements.safrano9999.txt /requirements.safrano9999.txt
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install -r /requirements.safrano9999.txt \
 && pip check

ENV ZEROINBOX_DIR=/opt/safrano9999/ZEROINBOX \
    KACHELMANN_PYTHON=/usr/bin/python3

COPY .safrano9999-source-tags.tsv /README/safrano9999-source-tags.tsv
COPY .fedora44-ai-repositories.list /usr/local/share/fedora44-ai/safrano9999-repositories.list
COPY .fedora44-image-runtime/manifest.tsv /usr/local/share/fedora44-ai/safrano9999-runtime-files.tsv
COPY .fedora44-image-runtime/systemd-enable.list /usr/local/share/fedora44-ai/safrano9999-systemd-enable.list
COPY .fedora44-image-runtime/rootfs/ /

COPY safrano9999/ /opt/safrano9999/

RUN uv pip install \
      --python /usr/local/lib/hermes-agent/venv/bin/python \
      --no-cache \
      "SQLAlchemy>=2.0" \
 && /usr/local/lib/hermes-agent/venv/bin/python -c 'import sqlalchemy'

COPY .fedora44-image-buildtime/ /tmp/fedora44-image-buildtime/
COPY build/run-container-buildtime.sh /tmp/fedora44-image-buildtime/run-container-buildtime
RUN --network=none \
    /tmp/fedora44-image-buildtime/run-container-buildtime \
      /tmp/fedora44-image-buildtime \
      fedora44-ai-safrano9999 \
      /opt/safrano9999 \
 && rm -rf /tmp/fedora44-image-buildtime \
 && rm -rf /opt/safrano9999/*/image/runtime

RUN /usr/local/bin/openclaw-ephemeral.py configure \
 && find /root/.openclaw -maxdepth 1 -name 'openclaw.json*' -delete

RUN while IFS= read -r unit || [ -n "$unit" ]; do \
      [ -n "$unit" ] || continue; \
      systemctl enable "$unit"; \
    done < /usr/local/share/fedora44-ai/safrano9999-systemd-enable.list

USER root
WORKDIR /root
STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
