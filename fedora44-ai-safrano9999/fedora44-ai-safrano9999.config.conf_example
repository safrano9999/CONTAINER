BIP39_PORT=11030

#default-preset: CET 07:00,CET 13:00,CET 19:00
OPENCLAW_CRONTAB_TIME=CET 07:00,CET 13:00,CET 19:00

#default-preset: WELCOME,NEXTCLOUD,DAILYNEWS,ZEROINBOX,SPANKER,KACHELMANN
OPENCLAW_CRONTAB_REPOS=WELCOME,NEXTCLOUD,DAILYNEWS,ZEROINBOX,SPANKER,KACHELMANN

#default-preset: WELCOME,NEXTCLOUD,DAILYNEWS,ZEROINBOX,SPANKER,KACHELMANN
OPENCLAW_REPOS_START_INIT=WELCOME,NEXTCLOUD,DAILYNEWS,ZEROINBOX,SPANKER,KACHELMANN

#default-preset: /var/lib/kachelmann/content
#required: Shared KACHELMANN content directory inside Fedora and the MCP sidecar
KACHELMANN_CONTENT_PATH=/var/lib/kachelmann/content

#default-preset: 10001
#required: Shared group used for KACHELMANN content directories and files
KACHELMANN_CONTENT_GID=10001

#default-preset: 1
CITADEL_CLOUDFLARE=1

#CONTAINER-NAME
#default-preset: fedora44-ai-core
#required:
CONTAINER_NAME=fedora44-ai-core

#default-preset: ${CONTAINER_NAME}
#required:
TS_HOSTNAME=${CONTAINER_NAME}

#default-preset: --ssh
TS_EXTRA_ARGS=--ssh

#mount-bind: FEDORA44_AI_INIT_HOOKS_PATH:/usr/local/share/fedora44-ai/init.d
#default-preset: %config-conf/fedora44-ai-init.d
FEDORA44_AI_INIT_HOOKS_PATH=%config-conf/fedora44-ai-init.d

#choices: 0 1
#default-preset: 0
CLOUDFLARED_START=0

#named-volume: /named_volumes/OPENCLAW /named_volumes/OPENCLAW/workspace /root/.openclaw/workspace dir
#named-volume: /named_volumes/OPENCLAW /named_volumes/OPENCLAW/agents /root/.openclaw/agents dir
#default-preset: 1
OPENCLAW_PERSISTENT=1

OPENCLAW_GATEWAY_PORT=18789

#default-preset: dummy/note
OPENCLAW_MODEL=dummy/note

#default-preset: 1
OPENCLAW_NOTE_FULL_MODE=1

#when: NOTE_DB_BACKEND=file
#required:
NOTE_PATH=./OBSIDIAN/NOTES/INBOX

#default-preset: 1
NOTE_FEEDBACK=1

#choices: none webhook cli
#default-preset: none
NOTE_TRIGGER_TYPE=none

#when-not: NOTE_TRIGGER_TYPE=none
#default-if: NOTE_TRIGGER_TYPE=webhook https://n8n.example.com/webhook/note
#default-if: NOTE_TRIGGER_TYPE=cli openclaw agent --agent notes --message "Message: $NOTE_MESSAGE Date: $NOTE_DATE Time: $NOTE_TIME Path: $NOTE_PATH Channel: $NOTE_CHANNEL Account: $NOTE_ACCOUNT_ID Sender: $NOTE_SENDER_ID Message-ID: $NOTE_MESSAGE_ID Prompt: $NOTE_PROMPT"
NOTE_TRIGGER=

#default-preset: prompt_default.md
NOTE_PROMPT=prompt_default.md

HERMES_DASHBOARD_PORT=9119

HERMES_API_SERVER_PORT=8642

#default-preset: /data
#required:
VDITOR_NOTES_PATH=/data

#default-preset: 11100
#required:
VDITOR_NOTES_PORT=11100

#publish-host: FASTAPI_HOST
#required: published host bind address
FASTAPI_HOST=127.0.0.1

#default-preset: http://127.0.0.1:18789,http://localhost:18789,http://127.0.0.1:20789
OPENCLAW_CONTROL_UI_ALLOWED_ORIGINS=http://127.0.0.1:18789,http://localhost:18789,http://127.0.0.1:20789

# 1 preset: add detected Tailscale and CITADEL/Cloudflare origins
#choices: 0 1
#default-preset: 1
OPENCLAW_CONTROL_UI_ALLOWED_ORIGINS_AUTO=1

#named-volume: /named_volumes/HERMES /named_volumes/HERMES/state.db @HOME@/.hermes/state.db link
#named-volume: /named_volumes/HERMES /named_volumes/HERMES/response_store.db @HOME@/.hermes/response_store.db link
#named-volume: /named_volumes/HERMES /named_volumes/HERMES/kanban.db @HOME@/.hermes/kanban.db link
#named-volume: /named_volumes/HERMES /named_volumes/HERMES/auth.json @HOME@/.hermes/auth.json link
#named-volume: /named_volumes/HERMES /named_volumes/HERMES/SOUL.md @HOME@/.hermes/SOUL.md link
#named-volume: /named_volumes/HERMES /named_volumes/HERMES/channel_directory.json @HOME@/.hermes/channel_directory.json link
#named-volume: /named_volumes/HERMES /named_volumes/HERMES/gateway_state.json @HOME@/.hermes/gateway_state.json link
#named-volume: /named_volumes/HERMES /named_volumes/HERMES/memories @HOME@/.hermes/memories dir
#named-volume: /named_volumes/HERMES /named_volumes/HERMES/sessions @HOME@/.hermes/sessions dir
#named-volume: /named_volumes/HERMES /named_volumes/HERMES/cron @HOME@/.hermes/cron dir
#named-volume: /named_volumes/HERMES /named_volumes/HERMES/profiles @HOME@/.hermes/profiles dir
#named-volume: /named_volumes/HERMES /named_volumes/HERMES/pairing @HOME@/.hermes/pairing dir
#named-volume: /named_volumes/HERMES /named_volumes/HERMES/platforms @HOME@/.hermes/platforms dir
#named-volume: /named_volumes/HERMES /named_volumes/HERMES/hooks @HOME@/.hermes/hooks dir
#named-volume: /named_volumes/HERMES /named_volumes/HERMES/scripts @HOME@/.hermes/scripts dir
#named-volume: /named_volumes/HERMES /named_volumes/HERMES/skills/custom @HOME@/.hermes/skills/custom dir
#default-preset: 1
HERMES_PERSISTENT=1

#required: CODEANALYST internal web UI port
CODEANALYST_PORT=11010

#required: CITADEL internal web UI port
CITADEL_WEBUI_PORT=11000

#named-volume: /named_volumes/CITADEL /named_volumes/CITADEL/ports.filter.json /opt/safrano9999/CITADEL/ports.filter.json file
#named-volume: /named_volumes/CITADEL /named_volumes/CITADEL/extensions/providers_state.json /opt/safrano9999/CITADEL/extensions/providers_state.json file
#named-volume: /named_volumes/CITADEL /named_volumes/CITADEL/extensions/enabled/cloudflare/routes.json /opt/safrano9999/CITADEL/extensions/enabled/cloudflare/routes.json file
#choices: 0 1
#default-preset: 1
CITADEL_PERSISTENT=1

# Optional: leave empty to disable subnet routes.
CITADEL_SUBNET_IP=

#default-preset: 0
#choices: 0 1
CITADEL_CONTAINER=0

#when: CITADEL_CONTAINER=1
#default-preset: 0
#choices: 0 1
CITADEL_CONTAINER_MAP=0

#when: CITADEL_CONTAINER_MAP=1
#default-preset: 65100
CITADEL_DEDUPE_PORT=65100

#default-preset: insert later
CITADEL_TAILSCALE=true

#required: Enable Tailscale discovery (0/1)
#default-preset: 0
CITADEL_TS_DISCOVERY=0

#default-preset: insert later
CITADEL_CLOUDFLARE_DOMAIN=

#default-preset: insert later
CITADEL_CLOUDFLARE_ACCOUNT_ID=

#default-preset: insert later
CITADEL_CLOUDFLARE_ZONE_ID=

#default-preset: insert later
CITADEL_CLOUDFLARE_TUNNEL_ID=

#required: JUGO internal web UI port
JUGO_PORT=11020

#blank-if: USE_TMUX=false JUGO_TMUX_SESSION_PREFIX
#required: JUGO tmux integration switch
USE_TMUX=false

#required: JUGO shell tmux mode
TMUX_SHELL=false

#required: JUGO tmux session prefix
JUGO_TMUX_SESSION_PREFIX=jugo

#required: Vikunja host
VIKUNJA_HOST=localhost

#required: Vikunja container name
VIKUNJA_CONTAINER=vikunja

#default-preset: vikai
#required: VikAI assignee username
ASSIGNEE_USERNAME=vikai

#default-preset: cli
#required: VikAI transport
TRANSPORT=cli

#default-preset: openclaw-tui
#required: VikAI target
TARGET=openclaw-tui

#default-preset: luna
#required: VikAI OpenClaw model
VIKAI_OPENCLAW_LLM=luna

#default-preset: luna
#required: VikAI Hermes model
VIKAI_HERMES_LLM=luna

#required: PV_D-A-CH internal web UI port
PV_DACH_PORT=11080

PV_DACH_OPENAI_V1_DEFAULT_LLM=luna

PV_DACH_QGIS_WEBHOOK_SERVER_ON=true

PV_DACH_QGIS_WEBHOOK_SERVER_PORT=11081

PV_DACH_QGIS_WEBHOOK_CLIENT_URL=

#required: KIWIX_BRIDGE internal web UI port
KIWIX_BRIDGE_PORT=11060

KIWIX_URL=https://127.0.0.1:450

#required: Napoleon internal web UI port
NAPOLEON_PORT=11050

#default-preset: luna
#required: Napoleon default OpenAI-v1 model
NAPOLEON_OPENAI_V1_DEFAULT_LLM=luna

#required: NaturalGrounding internal web UI port
NATURALGROUNDING_PORT=11070

#required: NaturalGrounding video storage path
#mount-bind: NATURALGROUNDING_VIDEOS_DIR:/opt/safrano9999/NaturalGrounding-Tiktok-Ying-Video-Manager/VIDEOS
NATURALGROUNDING_VIDEOS_DIR=VIDEOS

#required: SPANKER internal web UI port
SPANKER_PORT=11090

#required: KACHELMANN internal WebUI port
KACHELMANN_PORT=11040

#choices: false true
#default-preset: false
# Controls only the persistent Streamable HTTP MCP listener. Stdio remains on demand.
KACHELMANN_MCP_ENABLED=false

#default-preset: 11041
# Internal Streamable HTTP MCP port.
KACHELMANN_MCP_PORT=11041

#default-preset: 0
# 0 hides and blocks motivation; 1 enables on/off/motivate controls.
KACHELMANN_MOTIVATION=0

#default-preset: 1
# Initial STATUS.pdf setting. It remains controllable in the WebUI Config tab.
KACHELMANN_STATUS_PDF=1

