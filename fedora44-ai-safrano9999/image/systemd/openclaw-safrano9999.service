[Unit]
Description=Install safrano9999 OpenClaw plugins
After=openclaw-config.service openclaw-safrano9999-base.service vikai-bootstrap-openclaw-agents.service
Requires=openclaw-config.service openclaw-safrano9999-base.service vikai-bootstrap-openclaw-agents.service
Before=openclaw.service

[Service]
Type=oneshot
PassEnvironment=OPENCLAW_START OPENCLAW_CONFIG OPENCLAW_BIN OPENCLAW_CRONTAB OPENCLAW_TELEGRAM_CHAT_ID SAFRANO9999_ROUTINES_CRONTAB SAFRANO9999_ROUTINES_TZ
ExecCondition=/bin/bash -c '[ "$${OPENCLAW_START:-1}" = "1" ]'
ExecStart=/usr/local/bin/openclaw-layer-runtime --repos JUGO VikAI PV_D-A-CH KIWIX_BRIDGE NAPOLEON_HILLS_AI_MASTERMIND_CLASSES SOLANA_AIRGAPPED_DEBIAN_WORKFLOW NaturalGrounding-Tiktok-Ying-Video-Manager DAILYNEWS ZEROINBOX SPANKER KACHELMANN
RemainAfterExit=yes
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
