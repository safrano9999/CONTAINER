ARG AI_CORE2_IMAGE=ghcr.io/safrano9999/fedora44-ai-core2:latest
ARG AI_BASE_IMAGE=ghcr.io/safrano9999/fedora44-ai-base:latest
FROM ${AI_CORE2_IMAGE} AS ai-base

ARG NEXTCLOUD_PLUGIN_SHA256
ARG FEDORA44_AI_BASE_SOURCE_KEY
LABEL org.opencontainers.image.source="https://github.com/safrano9999/CONTAINER" \
      org.opencontainers.image.title="fedora44-ai-base" \
      org.opencontainers.image.description="Fedora 44 AI base services and OpenClaw plugins."
COPY requirements.base.txt /requirements.base.txt

RUN --mount=type=cache,target=/root/.cache/pip \
    pip install -r /requirements.base.txt \
 && pip check

ENV SAFRANO9999_STAGE_DIR=/opt/safrano9999/.stage
LABEL io.safrano9999.base-source-tags.sha256="${FEDORA44_AI_BASE_SOURCE_KEY}"
COPY .fedora44-ai-base-source-tags.tsv /README/fedora44-ai-base-source-tags.tsv
COPY safrano9999/WELCOME ${SAFRANO9999_STAGE_DIR}/WELCOME
COPY safrano9999/CODEANALYST ${SAFRANO9999_STAGE_DIR}/CODEANALYST
COPY safrano9999/CITADEL ${SAFRANO9999_STAGE_DIR}/CITADEL
COPY safrano9999/DIESDAS- ${SAFRANO9999_STAGE_DIR}/DIESDAS-
COPY safrano9999/NEXTCLOUD ${SAFRANO9999_STAGE_DIR}/NEXTCLOUD
COPY SCRIPTS /opt/safrano9999/SCRIPTS
COPY ref.base.conf ${SAFRANO9999_STAGE_DIR}/WELCOME/ref.conf

RUN mkdir -p /tmp/nextcloud-runtime \
 && test -n "${NEXTCLOUD_PLUGIN_SHA256}" \
 && curl -fsSL https://github.com/safrano9999/NEXTCLOUD/releases/download/latest/nextcloud-fedora64-plugin-latest.zip \
      -o /tmp/nextcloud-runtime/nextcloud-fedora64-plugin-latest.zip \
 && echo "${NEXTCLOUD_PLUGIN_SHA256}  /tmp/nextcloud-runtime/nextcloud-fedora64-plugin-latest.zip" \
      | sha256sum -c - \
 && unzip -q /tmp/nextcloud-runtime/nextcloud-fedora64-plugin-latest.zip 'runtime/*' -d ${SAFRANO9999_STAGE_DIR}/NEXTCLOUD \
 && rm -rf /tmp/nextcloud-runtime

RUN mkdir -p /README \
 && ln -f /opt/safrano9999/SCRIPTS/safrano9999/image/readme/paper.pdf /README/paper.pdf

RUN bash -lc 'chmod +x /opt/safrano9999/SCRIPTS/safrano9999/image/safrano9999_container.sh \
 && . /opt/safrano9999/SCRIPTS/safrano9999/image/safrano9999_container.sh \
 && safrano9999_standalone CODEANALYST DIESDAS- \
 && safrano9999_OC_plugins --link CITADEL \
 && safrano9999_OC_plugins --link --fullrun --crontab "CET 01:23,CET 07:00,CET 09:40,CET 12:00,CET 15:30,CET 19:00" \
      WELCOME NEXTCLOUD \
 && rm -rf "$SAFRANO9999_STAGE_DIR"'

RUN mkdir -p /opt/safrano9999/CITADEL/extensions/enabled \
 && if [ -d /opt/safrano9999/CITADEL/extensions/disabled/subnet ]; then \
      mv /opt/safrano9999/CITADEL/extensions/disabled/subnet /opt/safrano9999/CITADEL/extensions/enabled/subnet; \
    fi \
 && if [ -d /opt/safrano9999/CITADEL/extensions/disabled/tailscale ]; then \
      mv /opt/safrano9999/CITADEL/extensions/disabled/tailscale /opt/safrano9999/CITADEL/extensions/enabled/tailscale; \
    fi \
 && chmod +x /opt/safrano9999/CITADEL/scan.sh

COPY build/services/safrano9999_plugins.py /usr/local/bin/safrano9999_plugins.py
COPY build/services/openclaw_common.py /usr/local/bin/openclaw_common.py
COPY build/services/openclaw-safrano9999-build.py /usr/local/bin/openclaw-safrano9999-build.py
RUN /usr/local/bin/openclaw-ephemeral.py configure \
 && python3 /usr/local/bin/openclaw-safrano9999-build.py \
 && find /root/.openclaw -maxdepth 1 -name 'openclaw.json*' -delete

COPY build/services/citadel-scan.service build/services/citadel.service \
     build/services/codeanalyst.service build/services/safrano9999-welcome.service \
     /etc/systemd/system/
COPY openclaw-safrano9999-base.service /etc/systemd/system/openclaw-safrano9999.service
RUN install -m 0644 /opt/safrano9999/NEXTCLOUD/systemd/nextcloud-sync@.service /etc/systemd/system/nextcloud-sync@.service \
 && install -m 0755 /opt/safrano9999/NEXTCLOUD/systemd/nextcloud-timer-generator /usr/lib/systemd/system-generators/nextcloud-timer-generator
COPY build/services/systemd/openclaw.service.d/20-safrano9999.conf \
     /etc/systemd/system/openclaw.service.d/20-safrano9999.conf

RUN echo '{"hasCompletedOnboarding":true}' > /root/.claude.json

COPY build/services/openclaw-safrano9999.py /usr/local/bin/openclaw-safrano9999
COPY SCRIPTS/safrano9999/container/openclaw/openclaw_crontabs.sh /usr/local/bin/openclaw-crontabs
COPY SCRIPTS/safrano9999/container/openclaw/openclaw_allow_all.mjs /usr/local/bin/openclaw-allow-all

RUN install -m 0755 /opt/safrano9999/WELCOME/readme_welcome.py /usr/local/bin/safrano9999-welcome \
 && ln -f /opt/safrano9999/SCRIPTS/safrano9999-lib/py-core/python_header.py /usr/local/bin/python_header.py \
 && ln -f /opt/safrano9999/SCRIPTS/safrano9999-lib/py-core/openai_v1.py /usr/local/bin/openai_v1.py \
 && /opt/safrano9999/SCRIPTS/safrano9999/image/relink_shared.sh \
    --extra-root /usr/local/bin \
    --extra-root /etc/systemd/system \
    -- \
    config.sh python_header.py openai_v1.py \
    openclaw_common.py safrano9999_plugins.py \
    env.cloudflare.example config.cloudflare.conf_example config.cloudflare.container \
    sqlite_persistence.sh \
    readme_welcome.py safrano9999-welcome.service \
    20-safrano9999.conf

RUN sed -i 's#file:///app/dist/#file:///usr/local/lib/node_modules/openclaw/dist/#' \
      /usr/local/bin/openclaw-allow-all \
 && chmod +x /usr/local/bin/openclaw-safrano9999 \
    /usr/local/bin/safrano9999-welcome \
    /usr/local/bin/openclaw-crontabs \
    /usr/local/bin/openclaw-allow-all

RUN systemctl enable codeanalyst.service citadel.service citadel-scan.service \
    safrano9999-welcome.service openclaw-safrano9999.service

STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]

FROM ${AI_BASE_IMAGE} AS ai-safrano9999

ARG SAFRANO9999_SOURCE_KEY
LABEL org.opencontainers.image.source="https://github.com/safrano9999/CONTAINER" \
      org.opencontainers.image.title="fedora44-ai-safrano9999" \
      org.opencontainers.image.description="Fedora 44 AI Safrano service and plugin layer."

COPY requirements.safrano9999.txt /requirements.safrano9999.txt
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install -r /requirements.safrano9999.txt \
 && pip check

ENV ZEROINBOX_DIR=/opt/safrano9999/ZEROINBOX \
    KACHELMANN_PYTHON=/usr/bin/python3
LABEL io.safrano9999.source-tags.sha256="${SAFRANO9999_SOURCE_KEY}"
COPY ref.safrano9999.conf /opt/safrano9999/WELCOME/ref.conf

COPY .safrano9999-source-tags.tsv /README/safrano9999-source-tags.tsv
COPY safrano9999/JUGO ${SAFRANO9999_STAGE_DIR}/JUGO
COPY safrano9999/VikAI ${SAFRANO9999_STAGE_DIR}/VikAI
COPY safrano9999/PV_D-A-CH ${SAFRANO9999_STAGE_DIR}/PV_D-A-CH
COPY safrano9999/KIWIX_BRIDGE ${SAFRANO9999_STAGE_DIR}/KIWIX_BRIDGE
COPY safrano9999/NAPOLEON_HILLS_AI_MASTERMIND_CLASSES ${SAFRANO9999_STAGE_DIR}/NAPOLEON_HILLS_AI_MASTERMIND_CLASSES
COPY safrano9999/SOLANA_AIRGAPPED_DEBIAN_WORKFLOW ${SAFRANO9999_STAGE_DIR}/SOLANA_AIRGAPPED_DEBIAN_WORKFLOW
COPY safrano9999/NaturalGrounding-Tiktok-Ying-Video-Manager ${SAFRANO9999_STAGE_DIR}/NaturalGrounding-Tiktok-Ying-Video-Manager
COPY safrano9999/DAILYNEWS ${SAFRANO9999_STAGE_DIR}/DAILYNEWS
COPY safrano9999/ZEROINBOX ${SAFRANO9999_STAGE_DIR}/ZEROINBOX
COPY safrano9999/SPANKER ${SAFRANO9999_STAGE_DIR}/SPANKER
COPY safrano9999/KACHELMANN ${SAFRANO9999_STAGE_DIR}/KACHELMANN

RUN bash -lc '. /opt/safrano9999/SCRIPTS/safrano9999/image/safrano9999_container.sh \
 && safrano9999_standalone \
      JUGO VikAI PV_D-A-CH KIWIX_BRIDGE \
      NAPOLEON_HILLS_AI_MASTERMIND_CLASSES \
      SOLANA_AIRGAPPED_DEBIAN_WORKFLOW \
      NaturalGrounding-Tiktok-Ying-Video-Manager@feature/webui-db-backend-dual \
      DAILYNEWS ZEROINBOX SPANKER KACHELMANN \
 && _safrano9999_append_webhooks /opt/safrano9999 DAILYNEWS ZEROINBOX SPANKER KACHELMANN \
 && _safrano9999_append_fullrun /opt/safrano9999 DAILYNEWS ZEROINBOX SPANKER KACHELMANN \
 && printf "%s\n" "CET 01:23,CET 07:00,CET 09:40,CET 12:00,CET 15:30,CET 19:00" > /opt/safrano9999/.openclaw-crontab \
 && rm -rf "$SAFRANO9999_STAGE_DIR"'

RUN /usr/local/bin/openclaw-ephemeral.py configure \
 && python3 /usr/local/bin/openclaw-safrano9999-build.py \
 && find /root/.openclaw -maxdepth 1 -name 'openclaw.json*' -delete

COPY build/services/bip39.service build/services/jugo.service build/services/kiwix-bridge.service \
     build/services/napoleon.service build/services/naturalgrounding.service build/services/pvdach-qgis-webhook.service \
     build/services/pvdach.service /etc/systemd/system/
RUN install -m 0644 /opt/safrano9999/SPANKER/systemd/spanker-webui.service /etc/systemd/system/spanker-webui.service
COPY build/services/openclaw-safrano9999.service /etc/systemd/system/openclaw-safrano9999.service

COPY build/services/vikai-bootstrap-openclaw-agents.py /usr/local/bin/vikai-bootstrap-openclaw-agents
RUN chmod +x /usr/local/bin/vikai-bootstrap-openclaw-agents \
 && systemctl enable jugo.service pvdach.service pvdach-qgis-webhook.service \
      kiwix-bridge.service napoleon.service naturalgrounding.service bip39.service spanker-webui.service

STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
