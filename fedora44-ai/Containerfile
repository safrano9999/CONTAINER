COPY safrano9999/KIWIX_BRIDGE ${SAFRANO9999_STAGE_DIR}/KIWIX_BRIDGE
COPY safrano9999/NAPOLEON_HILLS_AI_MASTERMIND_CLASSES ${SAFRANO9999_STAGE_DIR}/NAPOLEON_HILLS_AI_MASTERMIND_CLASSES
COPY safrano9999/SOLANA_AIRGAPPED_DEBIAN_WORKFLOW ${SAFRANO9999_STAGE_DIR}/SOLANA_AIRGAPPED_DEBIAN_WORKFLOW
COPY safrano9999/NaturalGrounding-Tiktok-Ying-Video-Manager ${SAFRANO9999_STAGE_DIR}/NaturalGrounding-Tiktok-Ying-Video-Manager
COPY safrano9999/DAILYNEWS ${SAFRANO9999_STAGE_DIR}/DAILYNEWS
COPY safrano9999/ZEROINBOX ${SAFRANO9999_STAGE_DIR}/ZEROINBOX
COPY safrano9999/SPANKER ${SAFRANO9999_STAGE_DIR}/SPANKER
COPY safrano9999/KACHELMANN ${SAFRANO9999_STAGE_DIR}/KACHELMANN

RUN bash -lc '. /opt/safrano9999/SCRIPTS/safrano9999/image/safrano9999_container.sh \
 && safrano9999_standalone \
      JUGO VikAI PV_D-A-CH KIWIX_BRIDGE \
      NAPOLEON_HILLS_AI_MASTERMIND_CLASSES \
      SOLANA_AIRGAPPED_DEBIAN_WORKFLOW \
      NaturalGrounding-Tiktok-Ying-Video-Manager@feature/webui-db-backend-dual \
      DAILYNEWS ZEROINBOX SPANKER KACHELMANN \
 && _safrano9999_write_webhooks /opt/safrano9999 WELCOME NEXTCLOUD DAILYNEWS ZEROINBOX SPANKER KACHELMANN \
 && _safrano9999_write_fullrun /opt/safrano9999 WELCOME NEXTCLOUD DAILYNEWS ZEROINBOX SPANKER KACHELMANN \
 && printf "%s\n" "CET 01:23,CET 07:00,CET 09:40,CET 12:00,CET 15:30,CET 19:00" > /opt/safrano9999/.openclaw-crontab \
 && rm -rf "$SAFRANO9999_STAGE_DIR"'

RUN --mount=type=secret,id=github_token \
    KACHELMANN_APK_RELEASE_ID="${KACHELMANN_APK_RELEASE_ID}" \
      /opt/safrano9999/KACHELMANN/scripts/download-android-apk.sh \
      /opt/safrano9999/KACHELMANN

RUN python3 /usr/local/bin/openclaw-safrano9999-build.py

COPY build/services/bip39.service build/services/jugo.service build/services/kiwix-bridge.service \
     build/services/napoleon.service build/services/naturalgrounding.service build/services/pvdach-qgis-webhook.service \
     build/services/pvdach.service /etc/systemd/system/
RUN install -m 0644 /opt/safrano9999/SPANKER/systemd/spanker-webui.service /etc/systemd/system/spanker-webui.service
COPY build/services/openclaw-safrano9999.service /etc/systemd/system/openclaw-safrano9999.service

COPY build/services/vikai-bootstrap-openclaw-agents.py /usr/local/bin/vikai-bootstrap-openclaw-agents
RUN chmod +x /usr/local/bin/vikai-bootstrap-openclaw-agents \
 && systemctl enable jugo.service pvdach.service pvdach-qgis-webhook.service \
      kiwix-bridge.service napoleon.service naturalgrounding.service bip39.service spanker-webui.service

STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
