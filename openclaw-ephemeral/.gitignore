/*.env
/*_config.conf
/*_container.conf
/*_build.conf
/*-compose.yml
/*.container

# Local interpreter and test state.
**/__pycache__/
**/*.py[cod]
/.pytest_cache/
/.mypy_cache/
/.ruff_cache/
