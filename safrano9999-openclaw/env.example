# env.example - CALENDAR runtime env.
# Calendar URL/user/password entries are written by CALENDAR_init.sh.
# The first entry uses CALENDAR_*, then CALENDAR_2_*, CALENDAR_3_*, ...
# env.example - hardcoded source of truth for DAILYNEWS (OpenClaw plugin).
# DAILYNEWS needs NO secrets: all feeds, football, weather and trends are public.
# Kept for the container merge convention. Copy to .env only to override defaults.
# env.example - hardcoded source of truth for KACHELMANN (OpenClaw plugin / standalone WebUI).
# Leave the DB block EMPTY -> KACHELMANN falls back to SQLite (tilevault.sqlite3).
# Fill it for an external PostgreSQL / MySQL / MariaDB. Copy to .env for standalone use.

# SQL database (empty -> SQLite fallback)
KACHELMANN_DB_DRIVER=
KACHELMANN_DB_HOST=
KACHELMANN_DB_PORT=
KACHELMANN_DB_NAME=
KACHELMANN_DB_USER=
KACHELMANN_DB_PASS=

# Or a single connection URL instead of the fields above:
# KACHELMANN_DATABASE_URL=
# env.example - runtime credentials for ZEROINBOX.
# Account provider/user/password values are written by ZEROINBOX_init.sh.

# First account. Additional accounts use ZEROINBOX_PROVIDER_2,
# ZEROINBOX_EMAIL_2, ZEROINBOX_APP_PASSWORD_2, and so on.
ZEROINBOX_PROVIDER=gmail
ZEROINBOX_EMAIL=
ZEROINBOX_APP_PASSWORD=

# LiteLLM proxy used by ZEROINBOX itself for classification.
LITELLM_URL=
LITELLM_PORT=
LITELLM_API_KEY=
ZEROINBOX_MODEL=gemini/gemini-flash-lite-latest
# env.safrano9999-openclaw.example — hardcoded source of truth for the container itself.
# Container-only secrets/keys (not owned by any single plugin). setup.sh merges this
# last into the generated env.example; config.sh then asks for each and writes .env.

# OpenClaw gateway auth token — enables token auth on the gateway.
OPENCLAW_GATEWAY_TOKEN=example: openssl rand -hex 32

# Telegram bot token for OpenClaw's normal Telegram channel handling.
TELEGRAMTOKEN_OPENCLAW=

# Optional Telegram chat id used by startup/webhook/cron routine triggers.
# Slashcommands typed in Telegram do not need this; scheduled outbound messages do.
OPENCLAW_TELEGRAM_TARGET=

# Tailscale ephemeral auth key — lets the container join your tailnet, so you can
# reach the gateway and the container can reach your tailnet Postgres / LiteLLM.
TS_AUTHKEY=

# OPENCLAW_LITELLM_MODEL is intentionally unused in this container.
