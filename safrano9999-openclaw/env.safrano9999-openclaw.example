#required: OpenClaw gateway token
#secret
OPENCLAW_GATEWAY_TOKEN=example: openssl rand -hex 32

#required: OpenClaw Telegram bot token
#secret
OPENCLAW_TELEGRAMTOKEN=

#required: Telegram chat ID for scheduled plugin output
OPENCLAW_TELEGRAM_CHAT_ID=

# Optional bootstrap credential; persistent state is reused without it.
#secret
TS_AUTHKEY=
